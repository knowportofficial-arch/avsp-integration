# AVSP M9 — Publishing credentials (NEVER commit real values)
# Copy to .env and fill in. All real-API flags default to mock.

# Global mock toggle (true = mock even if tokens present)
AVSP_YOUTUBE_USE_MOCK=true
AVSP_FACEBOOK_USE_MOCK=true
AVSP_INSTAGRAM_USE_MOCK=true
AVSP_TELEGRAM_USE_MOCK=true
AVSP_WEB_USE_MOCK=true

# YouTube (Google OAuth / API)
AVSP_YOUTUBE_ENABLED=true
AVSP_YOUTUBE_CLIENT_ID=
AVSP_YOUTUBE_CLIENT_SECRET=
AVSP_YOUTUBE_ACCESS_TOKEN=
AVSP_YOUTUBE_REFRESH_TOKEN=
AVSP_YOUTUBE_CHANNEL_ID=

# Facebook (Meta Graph)
AVSP_FACEBOOK_ENABLED=true
AVSP_FACEBOOK_ACCESS_TOKEN=
AVSP_FACEBOOK_PAGE_ID=

# Instagram (Meta Graph — IG Business/Creator account)
AVSP_INSTAGRAM_ENABLED=true
AVSP_INSTAGRAM_ACCESS_TOKEN=
AVSP_INSTAGRAM_IG_USER_ID=

# Telegram Bot
AVSP_TELEGRAM_ENABLED=true
AVSP_TELEGRAM_BOT_TOKEN=
AVSP_TELEGRAM_CHAT_ID=

# Generic Web / API publishing
AVSP_WEB_ENABLED=true
AVSP_WEB_API_ENDPOINT=
AVSP_WEB_API_KEY=

# M9 storage paths (optional)
# AVSP_M9_QUEUE_DB=./data/m9_queue.db
# AVSP_M9_ANALYTICS_PATH=./data/m9_analytics.json
